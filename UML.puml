    'artifact "LPE_OP_NegativeCheck.drl"
    'artifact "LPI_NegativeCheck.drl"
    'artifact "PC_NegativeCheck.drl"
    'artifact "PC_OP_NegativeCheck.drl"
    'artifact "PE_NegativeCheck.drl"
    'artifact "PE_OP_NegativeCheck.drl"
