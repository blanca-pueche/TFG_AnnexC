}
package lipidexpertknowledge{
class LipidValidationAdductsType {
  - StringConverter<String> converter

  + getUniqueID() : String
  + getHeaderString() : String
  + fromString(s : String) : String
  + getStringConverter() : StringConverter
}

class LipidValidationCorrectDescriptionType {
    - StringConverter<String> converter

    + getUniqueID() : String
    + getHeaderString() : String
    + fromString(s : String) : String
    + getStringConverter() : StringConverter
}

class LipidValidationIncorrectDescriptionType {
    - StringConverter<String> converter

    + getUniqueID() : String
    + getHeaderString() : String
    + fromString(s : String) : String
    + getStringConverter() : StringConverter
}

class LipidValidationScoreType {
    + getUniqueID() : String
    + getHeaderString() : String
    + getDefaultVisibility() : boolean
}
class LipidValidationListType {
    - static List<DataType> subTypes
    + String getUniqueID()
    + String getHeaderString()
    + List<DataType> getSubDataTypes()
    + <K> K map(DataType<K> subType, FoundLipid lipid)
    + void saveToXML(XMLStreamWriter writer, Object value, ModularFeatureList flist, ModularFeatureListRow row, ModularFeature feature, RawDataFile file)
    + Object loadFromXML(XMLStreamReader reader, MZmineProject project, ModularFeatureList flist, ModularFeatureListRow row, ModularFeature feature, RawDataFile file)
    + boolean getDefaultVisibility()
}
}

' Relationships
CommonAdductNegative ..|> ExpertKnowledge : implements
CommonAdductPositive ..|> ExpertKnowledge : implements
CommonISFNegative ..|> ExpertKnowledge : implements
CommonISFPositive ..|> ExpertKnowledge : implements

Lipid --> "uses" CommonAdductPositive
Lipid --> "uses" CommonAdductNegative
Lipid --> "uses" CommonISFPositive
Lipid --> "uses" CommonISFNegative

FoundLipid *-- "1" Lipid : contains
FoundLipid *-- "0..*" FoundAdduct : has
FoundLipid --> MatchedLipid : links to

MobilePhaseParameter --> MobilePhaseComponent : manages UI for
MobilePhaseComponent --> MobilePhases : selects from
SampleTypeParameter --> SampleTypeComponent : manages UI for
SampleTypeComponent --> SampleTypes : selects from

LipidIDExpertKnowledgeParameters --> MobilePhaseParameter : contains
LipidIDExpertKnowledgeParameters --> SampleTypeParameter : contains

LipidIDExpertKnowledgeTask --> LipidIDExpertKnowledgeParameters : uses
LipidIDExpertKnowledgeTask --> MobilePhases : configured with
LipidIDExpertKnowledgeTask --> SampleTypes : configured with
LipidIDExpertKnowledgeTask --> LipidIDExpertKnowledgeSearch : calls

LipidIDExpertKnowledgeModule --> LipidIDExpertKnowledgeParameters : declares
LipidIDExpertKnowledgeModule --> LipidIDExpertKnowledgeTask : creates

LipidIDExpertKnowledgeSearch --> RowGroup : analyzes
LipidIDExpertKnowledgeSearch --> RowInfo : extracts
LipidIDExpertKnowledgeSearch --> ExpertKnowledge : matches
LipidIDExpertKnowledgeSearch --> FoundAdduct : detects
LipidIDExpertKnowledgeSearch --> MatchedLipid : verifies

LipidIDExpertKnowledgeSearch ..> "rules" : <<uses>> fires rules from

LipidValidationListType --> LipidValidationAdductsType
LipidValidationListType --> LipidValidationCorrectDescriptionType
LipidValidationListType --> LipidValidationIncorrectDescriptionType
LipidValidationListType --> LipidValidationScoreType

@enduml
