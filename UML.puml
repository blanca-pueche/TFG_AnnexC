      'artifact "LPE_PositiveCheck.drl"
      'artifact "LPE_OP_PositiveCheck.drl"
      'artifact "LPI_PositiveCheck.drl"
      'artifact "PC_PositiveCheck.drl"
      'artifact "PC_OP_PositiveCheck.drl"
      'artifact "PE_PositiveCheck.drl"
      'artifact "PE_OP_PositiveCheck.drl"
      'artifact "PI_PositiveCheck.drl"
